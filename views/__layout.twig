<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
        <div class="container">
            <i class="fa-solid fa-cubes me-2"></i>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav">
                    <!-- Оставил ссылку на главную -->
                    <li class="nav-item">
                    <a class="nav-link active" aria-current="page" href="/">Главная</a>
                    </li>
                    <!-- остальные заменил на цикл по типам -->
                    {% for type in types %}
                        <li class="nav-item">
                            <a class="nav-link" href="/?type={{ type.id }}">{{ type.title }}</a>
                        </li>
                    {% endfor %}
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="/search">Поиск</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="/create">Добавить</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active aria-current="page" href="/type_create">Добавить клан</a>
                    </li>
                </ul>
                <form action="/set-welcome/">
                    <input type="text" name="message" class="form-control mr-2 ml-2">
                </form>
                <form action="/logout" method="POST" class="d-flex ms-3">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="fa-solid fa-right-from-bracket"></i> Выйти
                    </button>
                </form>
            </div>
        </div>
    </nav>
    <div class="container">
        <div class="row">
            <div class="col-md-9">
                {% block content %}{% endblock %}
            </div>

            <div class="col-md-3">
                <div class="p-3 bg-light border rounded shadow-sm">
                    <h6 class="mb-3">Последние страницы которые вы посетили</h6>
                    <div class="list-group list-group-flush">
                        {% for url in history %}
                            <a href="{{ url }}" class="list-group-item list-group-item-action small py-2" style="background: #f8f9fa;">
                                {{ url }}
                            </a>
                        {% else %}
                            <p class="text-muted small">История пока пуста.</p>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>