{% import "macros.twig" as m %}

{% set is_ice = 'Лед' in item.title %}
{% set base_path = is_ice ? '/ice' : '/fire' %}
{% set theme_color = is_ice ? 'primary' : 'danger' %}

<div class="card" style="padding: 5px">
    <img src="{{ item.image }}" class="card-img-top mb-2" alt="{{ item.title }}" style="height: 200px;">
    
    <div class="card-body">
        <div class="d-grid mb-2">
            {{ m.btn(item.title, base_path, true, theme_color) }}
        </div>
        
        <div class="d-flex justify-content-center">
            {{ m.btn("Картинка", base_path ~ "/image", false) }}
            {{ m.btn("Описание", base_path ~ "/info", false) }}
        </div>
    </div>
</div>