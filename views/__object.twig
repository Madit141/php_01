    {% extends "__layout.twig" %}
{% import "macros.twig" as m %}

{% block content %}
    <h1>{{ title }}</h1>
    <ul class="nav nav-pills mb-3">
        <li class="nav-item me-2">
            {{ m.btn("Картинка", base_url ~ "/image", template == "object_image.twig") }}
        </li>
        <li class="nav-item">
            {{ m.btn("Описание", base_url ~ "/info", template in ["ice_info.twig", "fire_info.twig"]) }}
        </li>
    </ul>
    <div class="border p-4 rounded">
        {% block objectContent %}
            <p class="text-muted">Выберите раздел "Картинка" или "Описание", чтобы узнать больше о наборе.</p>
        {% endblock %}
    </div>
{% endblock %}