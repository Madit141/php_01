{% extends "__layout.twig" %}

{% block content %}
<div class="row d-flex">
    {% for object in fire_and_ice %}
        <div class="col-md-4 mb-4 d-flex align-items-stretch">
            <div class="border p-2 d-flex flex-column justify-content-between position-relative">
                <div class="position-absolute" style="right: -10px; top: -10px;" >
                    <form action="/fire_and_ice/delete" method="POST">
                        <input type="hidden" name="id" value="{{object.id}}">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-times"></i>
                        </button>
                    </form>
                </div>
                <div class="img-thumbnail mb-2" style="width: 100%; height: 210px; overflow:hidden">
                    <img src="{{ object.image }}" style="height: 100%; width: 100%; object-fit: cover;" alt="">
                </div>

                <div class="d-flex flex-column">
                    <a class="btn {% if object.type == 'Огонь' %}btn-danger{% else %}btn-primary{% endif %} mb-1" 
                       href="/fire_and_ice/{{ object.id }}">
                        {{ object.title }}
                    </a>
                    <div class="d-flex justify-content-center">
                        <a class="me-3" href="/fire_and_ice/{{ object.id }}?show=image" class="text-decoration-none">Картинка</a>
                        <a class="me-3" href="/fire_and_ice/{{ object.id }}?show=info" class="text-decoration-none">Описание</a>
                    </div>
                </div>
                
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}