{% extends "__layout.twig" %}

{% block content %}
    <ul class="list-group">
        {% for item in menu %}
            {% if item.url != '/' %}
                <li class="list-group-item d-flex align-items-center gap-3">
                    <a href="{{ item.url }}" class="btn {{ item.title == 'Лед' ? 'btn-primary' : 'btn-danger' }}">{{ item.title }}</a>
                    <a href="{{ item.url }}/image">Картинка</a>
                    <a href="{{ item.url }}/info">Описание</a>
                </li>
            {% endif %}
        {% endfor %}
    </ul>
{% endblock %}